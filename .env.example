# Public build-time value. Use the site key for the final workers.dev hostname.
TURNSTILE_SITE_KEY=
# Development defaults to disabled; production builds default to enabled.
# Set MAIL_ENABLED=false explicitly to pause enquiries and sign-in emails.
MAIL_ENABLED=false

# Local Worker secrets belong in ignored .dev.vars. Production values belong
# in Cloudflare secrets, never in this file or in client-side variables.
